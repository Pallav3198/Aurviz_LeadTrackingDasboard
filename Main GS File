function sendReminderNow(pin, kind, id) {
  checkPin_(pin);
  entity_(kind);
  const r = findRecord_(kind, id);
  if (!r) throw new Error('Record not found. Save it first.');
  const meeting = asDate_(r.nextMeeting);
  const upcoming = meeting && meeting.getTime() > Date.now() ? meeting : null;
  const to = recipientsFor_(r);
  if (!to.team.length && !(to.contact && upcoming)) throw new Error('No recipients. Pick team members under "Send to" and save.');
  if (to.team.length) sendTeamEmail_(kind, r, upcoming, to.team);
  if (to.contact && upcoming) sendContactEmail_(r, upcoming, to.contact);
  const sentTo = to.team.concat(to.contact && upcoming ? [to.contact] : []);
  log_(sentTo, r.name, 'Manual', 'Sent');
  return 'Reminder sent to ' + sentTo.length + ' recipient(s).';
}

/* ================================================================
 * Timers
 * ================================================================ */
function checkReminders() {
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(30000)) return;
  try {
    Object.keys(ENTITIES).forEach(remindEntity_);
    remindTasks_();
  } finally {
    lock.releaseLock();
  }
}

function remindEntity_(kind) {
  const ent = ENTITIES[kind];
  const sh = sheet_(ent.sheet);
  const sentCol = headerIndex_(headerRow_(sh))['Reminders Sent'];
  if (sentCol === undefined) return;
  const now = Date.now();
  readTable_(ent.sheet, ent.fields).forEach(r => {
    const meeting = asDate_(r.nextMeeting);
    if (!meeting || meeting.getTime() <= now) return;
    const chosen = splitList_(r.reminderTimes);
    if (!chosen.length) return;
    const stamp = meeting.toISOString();
    const sent = splitList_(r.remindersSent).filter(s => s.indexOf(stamp + '|') === 0);
    const due = REMINDER_OFFSETS.filter(o => chosen.indexOf(o.key) !== -1 &&
      sent.indexOf(stamp + '|' + o.key) === -1 && now >= meeting.getTime() - o.minutes * 60000);
    if (!due.length) return;

    // Several due at once (meeting booked late) → one email, mark the missed ones done
    const current = due[due.length - 1];
    const to = recipientsFor_(r);
    let status = 'Sent';
    if (!to.team.length && !to.contact) status = 'Skipped: no recipients';
    else {
      try {
        if (to.team.length) sendTeamEmail_(kind, r, meeting, to.team);
        if (to.contact) sendContactEmail_(r, meeting, to.contact);
      } catch (e) { status = 'Error: ' + e.message; }
    }
    sh.getRange(r._row, sentCol + 1).setValue(sent.concat(due.map(o => stamp + '|' + o.key)).join(', '));
    log_(to.team.concat(to.contact ? [to.contact] : []), r.name, current.label + ' before meeting', status);
  });
}

function remindTasks_() {
  const now = Date.now();
  const emails = {};
  teamList_().forEach(t => { emails[t.name.toLowerCase()] = t.email; });
  readTable_(SHEETS.TASKS, TASK_FIELDS).forEach(t => {
    if (t.status === 'Done' || asDate_(t.remindedAt)) return;
    const due = asDate_(t.due);
    if (!due || due.getTime() > now) return;
    let status = 'Skipped: too old';
    const to = emails[String(t.owner || '').toLowerCase()];
    if (now - due.getTime() < 6 * 3600e3) {
      if (!to) status = 'Skipped: task has no owner with an email';
      else {
        try {
          MailApp.sendEmail({
            to: to, name: senderName_(),
            subject: 'Task due: ' + t.title + (t.recordName ? ' (' + t.recordName + ')' : ''),
            htmlBody: '<div style="font-family:Arial,sans-serif;font-size:14px;color:#111827">' +
              '<p style="font-size:16px;margin:0 0 8px"><b>' + esc_(t.title) + '</b></p>' +
              (t.recordName ? '<p style="margin:0 0 4px">Related to: ' + esc_(t.recordName) + '</p>' : '') +
              '<p style="margin:0 0 4px">Due: ' + esc_(fmt_(due)) + '</p>' +
              (t.notes ? '<p>' + nl2br_(t.notes) + '</p>' : '') +
              '<p style="margin-top:16px;font-size:12px;color:#9ca3af"><a href="' + appUrl_() + '">Open tracker</a></p></div>'
          });
          status = 'Sent';
        } catch (e) { status = 'Error: ' + e.message; }
      }
    }
    writeRow_(SHEETS.TASKS, TASK_FIELDS, { remindedAt: new Date() }, t._row);
    if (status !== 'Skipped: too old') log_(to ? [to] : [], t.title, 'Task due', status);
  });
}

function hourlyJobs() {
  const hour = Number(Utilities.formatDate(new Date(), CONFIG.TIMEZONE, 'H'));
  const today = ymd_(new Date());
  const props = PropertiesService.getScriptProperties();
  if (hour >= CONFIG.DIGEST_HOUR && hour < CONFIG.DIGEST_HOUR + 3 && props.getProperty('digestDay') !== today) {
    props.setProperty('digestDay', today);
    sendDigest_(false);
  }
}

function sendDigest_(force) {
  const subs = teamList_().filter(t => /^y/i.test(t.digest));
  if (!subs.length) return 'No one has "Daily Digest" = Yes in the Team tab.';
  const now = new Date(), today = ymd_(now), DAY = 864e5;
  const staleAfter = staleDays_();

  const meetings = [], stale = [];
  Object.keys(ENTITIES).forEach(kind => {
    const ent = ENTITIES[kind];
    readTable_(ent.sheet, ent.fields).forEach(r => {
      const m = asDate_(r.nextMeeting);
      if (m && ymd_(m) === today) meetings.push({ kind: kind, r: r, m: m });
      const open = ent.closed.indexOf(String(r.stage)) === -1;
      const last = asDate_(r.lastMeeting) || asDate_(r.createdAt);
      if (open && r.priority === 'High' && !(m && m > now) && last && (now - last) / DAY >= staleAfter) {
        stale.push({ kind: kind, r: r, days: Math.floor((now - last) / DAY) });
      }
    });
  });
  meetings.sort((a, b) => a.m - b.m);
  const tasks = readTable_(SHEETS.TASKS, TASK_FIELDS).filter(t => {
    const d = asDate_(t.due);
    return t.status !== 'Done' && d && ymd_(d) <= today;
  }).sort((a, b) => asDate_(a.due) - asDate_(b.due));

  if (!force && !meetings.length && !tasks.length && !stale.length) return 'Nothing to send today.';

  const li = items => items.length ? '<ul style="padding-left:18px;margin:6px 0 16px">' + items.join('') + '</ul>' : '<p style="color:#6b7280;margin:6px 0 16px">None</p>';
  const tag = kind => kind === 'investor' ? ' <span style="color:#7c3aed">[Investor]</span>' : '';
  const html = '<div style="font-family:Arial,sans-serif;font-size:14px;color:#111827;max-width:600px">' +
    '<h2 style="margin:0 0 4px">Good morning</h2><p style="color:#6b7280;margin:0 0 16px">' +
    esc_(Utilities.formatDate(now, CONFIG.TIMEZONE, 'EEEE, d MMMM')) + '</p>' +
    '<h3 style="margin:0">Meetings today (' + meetings.length + ')</h3>' +
    li(meetings.map(x => '<li><b>' + esc_(Utilities.formatDate(x.m, CONFIG.TIMEZONE, 'h:mm a')) + '</b> — ' +
      esc_(x.r.name) + (x.r.organization ? ', ' + esc_(x.r.organization) : '') + tag(x.kind) + '</li>')) +
    '<h3 style="margin:0">Tasks due or overdue (' + tasks.length + ')</h3>' +
    li(tasks.map(t => { const d = asDate_(t.due); const od = d < now && ymd_(d) !== today;
      return '<li>' + (od ? '<span style="color:#dc2626">Overdue</span> · ' : '') + esc_(t.title) +
        (t.recordName ? ' — ' + esc_(t.recordName) : '') + (t.owner ? ' <span style="color:#6b7280">(' + esc_(t.owner) + ')</span>' : '') + '</li>'; })) +
    '<h3 style="margin:0">High-priority, no contact in ' + staleAfter + '+ days (' + stale.length + ')</h3>' +
    li(stale.slice(0, 10).map(x => '<li>' + esc_(x.r.name) + (x.r.organization ? ', ' + esc_(x.r.organization) : '') +
      tag(x.kind) + ' — ' + x.days + ' days</li>')) +
    '<p style="font-size:12px;color:#9ca3af"><a href="' + appUrl_() + '">Open tracker</a> · To stop these, set Daily Digest to No in the Team tab.</p></div>';

  MailApp.sendEmail({
    to: subs.map(s => s.email).join(','), name: senderName_(), htmlBody: html,
    subject: 'Today: ' + meetings.length + ' meeting(s), ' + tasks.length + ' task(s) due'
  });
  log_(subs.map(s => s.email), 'Daily digest', 'Digest', 'Sent');
  return 'Digest sent to ' + subs.length + ' person(s).';
}

/* ================================================================
 * Emails
 * ================================================================ */
function sendTeamEmail_(kind, r, meeting, to) {
  const subject = meeting
    ? 'Reminder: ' + r.name + ' — meeting ' + inWords_(meeting) + ' (' + Utilities.formatDate(meeting, CONFIG.TIMEZONE, 'h:mm a') + ')'
    : 'Follow-up reminder: ' + r.name;
  const digits = waDigits_(r.whatsapp || r.phone);
  const row = (k, v) => v ? '<tr><td style="padding:5px 12px 5px 0;color:#6b7280;vertical-align:top;white-space:nowrap">' + k +
    '</td><td style="padding:5px 0;color:#111827">' + v + '</td></tr>' : '';
  const d = v => asDate_(v) ? esc_(fmt_(asDate_(v))) : '';
  const money = v => Number(v) ? '₹' + Number(v).toLocaleString('en-IN') : '';

  let rows = row(kind === 'investor' ? 'Firm / Fund' : 'Organization', esc_(r.organization)) +
    row('Designation', esc_(r.title)) + row('Stage', esc_(r.stage)) + row('Priority', esc_(r.priority));
  if (kind === 'investor') {
    rows += row('Investor type', esc_(r.investorType)) + row('Cheque size', esc_(r.chequeSize)) +
      row('Tier', esc_(r.tier)) + row('Deck shared', esc_(r.deckShared)) + row('Warm intro via', esc_(r.warmIntro)) +
      row('Amount discussed', money(r.amountDiscussed));
  } else {
    rows += row('Type', esc_(r.type)) + row('Product', esc_(r.product)) + row('Deal value', money(r.dealValue));
  }
  rows += row('Preferred contact', esc_(r.preferredContact)) +
    row('Email', r.email ? '<a href="mailto:' + esc_(r.email) + '">' + esc_(r.email) + '</a>' : '') +
    row('Phone', r.phone ? '<a href="tel:' + esc_(r.phone) + '">' + esc_(r.phone) + '</a>' +
      (digits ? ' · <a href="https://wa.me/' + digits + '">WhatsApp</a>' : '') : '') +
    row('LinkedIn', r.linkedin ? '<a href="' + esc_(normalizeUrl_(r.linkedin)) + '">View profile</a>' : '') +
    row('Meeting link / venue', esc_(r.meetingLink)) + row('Next step', esc_(r.nextStep)) +
    row('Last contact', d(r.lastMeeting)) + row('Previous discussion', nl2br_(r.summary)) + row('Remarks', nl2br_(r.remarks));

  const recent = activitiesFor_(r.id).filter(a => a.type !== 'Created').slice(0, 3);
  const recentHtml = recent.length ? '<h3 style="font-size:14px;margin:18px 0 6px">Recent activity</h3><ul style="padding-left:18px;margin:0">' +
    recent.map(a => '<li style="margin-bottom:4px"><b>' + esc_(a.type) + '</b> · ' + d(a.date) + ' — ' + esc_(a.summary) + '</li>').join('') + '</ul>' : '';

  const html = '<div style="font-family:Arial,sans-serif;max-width:580px">' +
    '<h2 style="margin:0 0 4px;color:#111827">' + esc_(r.name) + (kind === 'investor' ? ' <span style="font-size:13px;color:#7c3aed">Investor</span>' : '') + '</h2>' +
    '<p style="margin:0 0 16px;color:#2563eb;font-weight:bold">' + (meeting ? 'Meeting ' + esc_(inWords_(meeting)) + ' · ' + esc_(fmt_(meeting)) : 'No upcoming meeting set') + '</p>' +
    '<table style="border-collapse:collapse;font-size:14px">' + rows + '</table>' + recentHtml +
    '<p style="margin-top:20px;font-size:12px;color:#9ca3af">Sent by ' + esc_(senderName_()) + ' · <a href="' + appUrl_() + '">Open tracker</a></p></div>';
  MailApp.sendEmail({ to: to.join(','), subject: subject, htmlBody: html, name: senderName_() });
}

// The contact gets a short polite note — never your internal notes.
function sendContactEmail_(r, meeting, to) {
  const first = String(r.name || '').replace(/^(dr\.?|mr\.?|ms\.?|mrs\.?)\s+/i, '').split(' ')[0] || 'there';
  const salutation = /^dr\.?\s/i.test(String(r.name)) ? 'Dr. ' + first : first;
  const html = '<div style="font-family:Arial,sans-serif;font-size:14px;color:#111827">' +
    '<p>Hi ' + esc_(salutation) + ',</p>' +
    '<p>A quick reminder of our meeting on <b>' + esc_(fmt_(meeting)) + '</b> (' + esc_(inWords_(meeting)) + ').' +
    (r.meetingLink ? '<br>Link / venue: ' + esc_(r.meetingLink) : '') + '</p>' +
    '<p>Looking forward to speaking with you.</p>' +
    '<p>Best regards,<br>' + esc_(senderName_()) + '</p></div>';
  MailApp.sendEmail({ to: to, subject: 'Reminder: our meeting ' + inWords_(meeting), htmlBody: html, name: senderName_() });
}

/* ================================================================
 * Sheet helpers
 * ================================================================ */
function readTable_(sheetName, fields) {
  const sh = sheet_(sheetName);
  const values = sh.getDataRange().getValues();
  if (values.length < 2) return [];
  const idx = headerIndex_(values[0].map(h => String(h).trim()));
  const out = [], missingId = [];
  values.slice(1).forEach((row, i) => {
    const o = { _row: i + 2 };
    fields.forEach(fd => { o[fd.k] = idx[fd.h] === undefined ? '' : row[idx[fd.h]]; });
    const hasId = String(o.id || '').trim() !== '';
    if (!hasId && !String(o.name || o.title || o.summary || '').trim()) return;   // blank row
    if (!hasId) { o.id = newId_(); missingId.push(o); }                          // typed directly into the sheet
    out.push(o);
  });
  if (missingId.length && idx['ID'] !== undefined) {
    missingId.forEach(o => sh.getRange(o._row, idx['ID'] + 1).setValue(o.id));
  }
  return out;
}

// rec values that are undefined leave the cell unchanged (partial updates)
function writeRow_(sheetName, fields, rec, rowNum) {
  const sh = sheet_(sheetName);
  const header = headerRow_(sh);
  const idx = headerIndex_(header);
  if (!rowNum && !rec.id) rec.id = newId_();
  const row = rowNum ? sh.getRange(rowNum, 1, 1, header.length).getValues()[0] : new Array(header.length).fill('');
  fields.forEach(fd => {
    const c = idx[fd.h];
    if (c !== undefined && rec[fd.k] !== undefined) row[c] = rec[fd.k] === null ? '' : rec[fd.k];
  });
  if (rowNum) sh.getRange(rowNum, 1, 1, header.length).setValues([row]);
  else sh.appendRow(row);
}

function deleteWhere_(sheetName, fields, pred) {
  const sh = sheet_(sheetName);
  readTable_(sheetName, fields).filter(pred).sort((a, b) => b._row - a._row).forEach(r => sh.deleteRow(r._row));
}

function updateWhere_(sheetName, fields, pred, upd) {
  readTable_(sheetName, fields).filter(pred).forEach(r => writeRow_(sheetName, fields, Object.assign({}, upd), r._row));
}

function renameRelated_(recordId, name) {
  updateWhere_(SHEETS.TASKS, TASK_FIELDS, t => String(t.recordId) === String(recordId), { recordName: name });
  updateWhere_(SHEETS.ACTIVITIES, ACTIVITY_FIELDS, a => String(a.recordId) === String(recordId), { recordName: name });
}

function addActivity_(kind, recordId, recordName, date, type, summary, by) {
  writeRow_(SHEETS.ACTIVITIES, ACTIVITY_FIELDS, {
    id: newId_(), kind: kind, recordId: recordId, recordName: cleanText_(recordName), date: date,
    type: type, summary: cleanText_(summary), by: cleanText_(by || ''), createdAt: new Date()
  }, null);
}

function activitiesFor_(recordId) {
  return readTable_(SHEETS.ACTIVITIES, ACTIVITY_FIELDS)
    .filter(a => String(a.recordId) === String(recordId))
    .sort((a, b) => (asDate_(b.date) || 0) - (asDate_(a.date) || 0));
}

function addTask_(t) {
  writeRow_(SHEETS.TASKS, TASK_FIELDS, {
    id: newId_(), title: cleanText_(t.title), due: asDate_(t.due) || '', owner: cleanText_(t.owner || ''),
    status: 'Open', recordName: cleanText_(t.recordName || ''), kind: t.kind || '', recordId: t.recordId || '',
    notes: cleanText_(t.notes || ''), createdAt: new Date()
  }, null);
}

function findRecord_(kind, id) {
  const ent = entity_(kind);
  return readTable_(ent.sheet, ent.fields).find(r => String(r.id) === String(id)) || null;
}

function entity_(kind) {
  const e = ENTITIES[kind];
  if (!e) throw new Error('Unknown record type.');
  return e;
}

function toClient_(fields, o) {
  const r = {};
  fields.forEach(fd => {
    const v = o[fd.k];
    if (fd.type === 'date' || fd.type === 'datetime' || fd.type === 'hidden-date') r[fd.k] = iso_(v);
    else if (fd.type === 'number') r[fd.k] = v === '' || v === null || v === undefined || isNaN(Number(v)) ? '' : Number(v);
    else if (v instanceof Date) r[fd.k] = v.toISOString();
    else r[fd.k] = v === null || v === undefined ? '' : String(v);
  });
  return r;
}

function fromClient_(fields, input) {
  const r = {};
  fields.forEach(fd => {
    if (fd.type === 'hidden' || fd.type === 'hidden-date') return;
    if (!Object.prototype.hasOwnProperty.call(input, fd.k)) return;
    const v = input[fd.k];
    if (fd.type === 'date' || fd.type === 'datetime') r[fd.k] = asDate_(v) || '';
    else if (fd.type === 'number') {
      const n = Number(String(v === null || v === undefined ? '' : v).replace(/[^\d.\-]/g, ''));
      r[fd.k] = v === '' || v === null || v === undefined || isNaN(n) ? '' : n;
    }
    else if (fd.type === 'checkbox') r[fd.k] = v === true || v === 'Yes' ? 'Yes' : 'No';
    else if (fd.type === 'url') r[fd.k] = cleanText_(normalizeUrl_(v));
    else r[fd.k] = cleanText_(v, fd.type);
  });
  return r;
}

function checkPin_(pin) {
  const cache = CacheService.getScriptCache();
  const fails = Number(cache.get('pinFails') || 0);
  if (fails >= 20) throw new Error('Too many wrong PIN attempts. Try again in 10 minutes.');
  const expected = getSetting_('Access PIN');
  if (!expected || String(pin || '').trim() !== expected) {
    cache.put('pinFails', String(fails + 1), 600);
    throw new Error('Invalid PIN.');
  }
}

function withLock_(fn) {
  const lock = LockService.getScriptLock();
  lock.waitLock(25000);
  try { return fn(); } finally { lock.releaseLock(); }
}

function sheet_(name) {
  const sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(name);
  if (!sh) throw new Error('Tab "' + name + '" not found. Run Lead Tracker → Run setup in the sheet.');
  return sh;
}

function ensureSheet_(ss, name, headers) {
  const sh = ss.getSheetByName(name) || ss.insertSheet(name);
  const current = headerRow_(sh);
  if (!current.filter(String).length) {
    sh.getRange(1, 1, 1, headers.length).setValues([headers]);
  } else {
    const missing = headers.filter(h => current.indexOf(h) === -1);
    if (missing.length) sh.getRange(1, current.length + 1, 1, missing.length).setValues([missing]);
  }
  sh.getRange(1, 1, 1, sh.getLastColumn()).setFontWeight('bold').setBackground('#1f2937').setFontColor('#ffffff');
  sh.setFrozenRows(1);
  return sh;
}

function headerRow_(sh) {
  const cols = sh.getLastColumn();
  return cols ? sh.getRange(1, 1, 1, cols).getValues()[0].map(h => String(h).trim()) : [];
}

function headerIndex_(header) {
  const idx = {};
  header.forEach((h, i) => { if (h && idx[h] === undefined) idx[h] = i; });
  return idx;
}

function setDropdown_(sh, col, list) {
  if (col === undefined || !list) return;
  const rule = SpreadsheetApp.newDataValidation().requireValueInList(list, true).setAllowInvalid(true).build();
  sh.getRange(2, col + 1, sh.getMaxRows() - 1, 1).setDataValidation(rule);
}

function teamList_() {
  const sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(SHEETS.TEAM);
  if (!sh || sh.getLastRow() < 2) return [];
  const width = Math.max(3, sh.getLastColumn());
  return sh.getRange(2, 1, sh.getLastRow() - 1, width).getValues()
    .map(r => ({ name: String(r[0]).trim(), email: String(r[1]).trim(), digest: String(r[2] || '').trim() }))
    .filter(t => t.name && t.email.indexOf('@') > 0);
}

function recipientsFor_(r) {
  const map = {};
  teamList_().forEach(t => { map[t.name.toLowerCase()] = t.email; });
  const team = [];
  splitList_(r.recipients).forEach(n => {
    const e = map[n.toLowerCase()];
    if (e && team.indexOf(e) === -1) team.push(e);
  });
  const contact = r.remindContact === 'Yes' && String(r.email).indexOf('@') > 0 ? String(r.email).trim() : '';
  return { team: team, contact: contact };
}

function settingsRows_() {
  const sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(SHEETS.SETTINGS);
  if (!sh || sh.getLastRow() < 2) return [];
  return sh.getRange(2, 1, sh.getLastRow() - 1, 2).getValues();
}

function hasSetting_(key) {
  return settingsRows_().some(x => String(x[0]).trim().toLowerCase() === key.toLowerCase());
}

function getSetting_(key) {
  const r = settingsRows_().find(x => String(x[0]).trim().toLowerCase() === key.toLowerCase());
  return r ? String(r[1]).trim() : '';
}

function staleDays_() { return Number(getSetting_('Stale after (days)')) || 14; }
function senderName_() { return getSetting_('Email sender name') || CONFIG.APP_TITLE; }
function appUrl_() { try { return ScriptApp.getService().getUrl() || ''; } catch (e) { return ''; } }

function log_(to, related, label, status) {
  const sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(SHEETS.LOG);
  if (sh) sh.appendRow([new Date(), (to || []).join(', '), related, label, status]);
}

function countBy_(list, key, order) {
  const counts = {};
  list.forEach(r => { const v = String(r[key] || '').trim() || 'Not set'; counts[v] = (counts[v] || 0) + 1; });
  const out = order.filter(o => counts[o]).map(o => [o, counts[o]]);
  Object.keys(counts).filter(k => order.indexOf(k) === -1)
    .sort((a, b) => counts[b] - counts[a])
    .forEach(k => out.push([k, counts[k]]));
  return out;
}

function newId_() { return Utilities.getUuid().replace(/-/g, '').slice(0, 10); }
function splitList_(v) { return String(v || '').split(',').map(s => s.trim()).filter(Boolean); }
function ymd_(d) { return Utilities.formatDate(d, CONFIG.TIMEZONE, 'yyyy-MM-dd'); }

function asDate_(v) {
  if (v instanceof Date) return isNaN(v.getTime()) ? null : v;
  if (!v) return null;
  const d = new Date(v);
  return isNaN(d.getTime()) ? null : d;
}

function iso_(v) { const d = asDate_(v); return d ? d.toISOString() : ''; }

function waDigits_(v) {
  let d = String(v || '').replace(/\D/g, '');
  if (d.length === 10) d = '91' + d;          // Indian number without country code
  return d.length >= 11 ? d : '';
}

function normalizeUrl_(v) {
  const s = String(v || '').trim();
  if (!s) return '';
  return /^https?:\/\//i.test(s) ? s : 'https://' + s.replace(/^\/+/, '');
}

function cleanText_(v, type) {
  if (v === null || v === undefined) return '';
  let s = String(v).trim();
  if (type === 'tel') return s.replace(/^=+/, '');         // phone column is plain text
  if (/^[=+\-@]/.test(s)) s = "'" + s;                       // never let text become a formula
  return s;
}

function fmt_(d) { return Utilities.formatDate(d, CONFIG.TIMEZONE, "EEE, d MMM yyyy 'at' h:mm a"); }

function inWords_(meeting) {
  const mins = Math.max(0, Math.round((meeting.getTime() - Date.now()) / 60000));
  if (mins < 1) return 'now';
  if (mins < 60) return 'in ' + mins + ' min';
  const h = Math.floor(mins / 60), m = mins % 60;
  return 'in ' + h + ' hr' + (h > 1 ? 's' : '') + (m ? ' ' + m + ' min' : '');
}

function esc_(s) {
  return String(s === null || s === undefined ? '' : s)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

function nl2br_(s) { return esc_(s).replace(/\n/g, '<br>'); }
