/* ---------------- Field definitions ----------------
 * k = key in code, label = shown in app, h = column header in the sheet. */
function f_(k, label, type, sec, extra) {
  return Object.assign({ k: k, label: label, h: label, type: type, sec: sec || '' }, extra || {});
}

function contactFields_(orgLabel) {
