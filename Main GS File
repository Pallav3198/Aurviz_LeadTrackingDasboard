/* ================================================================
 * Setup & migration
 * ================================================================ */
function setup() {
  const moved = withLock_(() => ensureStructure_());
  PropertiesService.getScriptProperties().setProperty('schema', CONFIG.SCHEMA_VERSION);

  ScriptApp.getProjectTriggers()
    .filter(t => ['checkReminders', 'hourlyJobs'].indexOf(t.getHandlerFunction()) !== -1)
    .forEach(t => ScriptApp.deleteTrigger(t));
  ScriptApp.newTrigger('checkReminders').timeBased().everyMinutes(CONFIG.CHECK_EVERY_MINUTES).create();
  ScriptApp.newTrigger('hourlyJobs').timeBased().everyHours(1).create();

  Logger.log('Setup complete. Access PIN: ' + getSetting_('Access PIN'));
  return moved;
}

function ensureStructureIfNeeded_() {
  const props = PropertiesService.getScriptProperties();
  if (props.getProperty('schema') === CONFIG.SCHEMA_VERSION) return;
  withLock_(() => ensureStructure_());
  props.setProperty('schema', CONFIG.SCHEMA_VERSION);
}

function ensureStructure_() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  ss.setSpreadsheetTimeZone(CONFIG.TIMEZONE);

  const oldLeads = ss.getSheetByName(SHEETS.LEADS);
  if (oldLeads) {
    // Version 1 → 2 column renames
    renameHeader_(oldLeads, 'Company', 'Product');
    renameHeader_(oldLeads, 'Last Meeting', 'Last Contact');
  } else {
    const sheets = ss.getSheets();
    if (sheets.length === 1 && sheets[0].getLastRow() === 0) sheets[0].setName(SHEETS.LEADS);
  }

  const leads = ensureSheet_(ss, SHEETS.LEADS, LEAD_FIELDS.map(x => x.h));
  const invs = ensureSheet_(ss, SHEETS.INVESTORS, INVESTOR_FIELDS.map(x => x.h));
  const tasks = ensureSheet_(ss, SHEETS.TASKS, TASK_FIELDS.map(x => x.h));
  const acts = ensureSheet_(ss, SHEETS.ACTIVITIES, ACTIVITY_FIELDS.map(x => x.h));

  const team = ensureSheet_(ss, SHEETS.TEAM, ['Name', 'Email', 'Daily Digest']);
  if (team.getLastRow() < 2) team.appendRow(['Me', Session.getEffectiveUser().getEmail(), 'Yes']);

  const settings = ensureSheet_(ss, SHEETS.SETTINGS, ['Setting', 'Value']);
  if (!getSetting_('Access PIN')) settings.appendRow(['Access PIN', String(Math.floor(100000 + Math.random() * 900000))]);
  SETTINGS_DEFAULTS.forEach(([k, v]) => { if (!hasSetting_(k)) settings.appendRow([k, v]); });

  ensureSheet_(ss, SHEETS.LOG, ['Sent At', 'To', 'Related To', 'Reminder', 'Status']);

  const moved = migrateInvestorsFromLeads_();
  fillDefaults_();

  applyFormats_(leads, LEAD_FIELDS);
  applyFormats_(invs, INVESTOR_FIELDS);
  applyFormats_(tasks, TASK_FIELDS);
  applyFormats_(acts, ACTIVITY_FIELDS);
  setDropdown_(tasks, headerIndex_(headerRow_(tasks))['Status'], ['Open', 'Done']);
  return moved;
}

function renameHeader_(sh, from, to) {
  const header = headerRow_(sh);
  const i = header.indexOf(from);
  if (i !== -1 && header.indexOf(to) === -1) sh.getRange(1, i + 1).setValue(to);
}

// Version 1 had a "Potential Investor" Yes/No column. Those rows move to Investors.
function migrateInvestorsFromLeads_() {
  const sh = sheet_(SHEETS.LEADS);
  const col = headerRow_(sh).indexOf('Potential Investor');
  if (col === -1) return 0;
  const values = sh.getDataRange().getValues();
  const yes = readTable_(SHEETS.LEADS, LEAD_FIELDS)
    .filter(r => String(values[r._row - 1][col]).trim().toLowerCase() === 'yes');
  if (!yes.length) return 0;

  const existing = readTable_(SHEETS.INVESTORS, INVESTOR_FIELDS).map(r => String(r.id));
  yes.forEach(r => {
    if (existing.indexOf(String(r.id)) !== -1) return;
    const rec = {};
    INVESTOR_FIELDS.forEach(fd => { if (r[fd.k] !== undefined && r[fd.k] !== '') rec[fd.k] = r[fd.k]; });
    rec.stage = 'Outreach';
    rec.stageChangedAt = new Date();
    rec.updatedAt = new Date();
    writeRow_(SHEETS.INVESTORS, INVESTOR_FIELDS, rec, null);
    addActivity_('investor', rec.id, rec.name, new Date(), 'Note', 'Moved from Leads to Investors', '');
  });
  yes.sort((a, b) => b._row - a._row).forEach(r => sh.deleteRow(r._row));
  return yes.length;
}

function fillDefaults_() {
  Object.keys(ENTITIES).forEach(kind => {
    const ent = ENTITIES[kind];
    readTable_(ent.sheet, ent.fields).forEach(r => {
      const upd = {};
      if (!String(r.stage).trim()) upd.stage = ent.stages[0];
      if (!String(r.priority).trim()) upd.priority = 'Medium';
      if (!asDate_(r.createdAt)) upd.createdAt = new Date();
      if (Object.keys(upd).length) writeRow_(ent.sheet, ent.fields, upd, r._row);
    });
  });
}

function applyFormats_(sh, fields) {
  const idx = headerIndex_(headerRow_(sh));
  const rows = sh.getMaxRows() - 1;
  if (rows < 1) return;
  fields.forEach(fd => {
    const c = idx[fd.h];
    if (c === undefined) return;
    const rng = sh.getRange(2, c + 1, rows, 1);
    if (fd.type === 'select') setDropdown_(sh, c, fd.opts);
    else if (fd.type === 'date') rng.setNumberFormat('d mmm yyyy');
    else if (fd.type === 'datetime' || fd.type === 'hidden-date') rng.setNumberFormat('d mmm yyyy, h:mm am/pm');
    else if (fd.type === 'tel') rng.setNumberFormat('@');
    else if (fd.type === 'number') rng.setNumberFormat('#,##0');
    else if (fd.type === 'checkbox') setDropdown_(sh, c, ['Yes', 'No']);
  });
}

/* ================================================================
 * Read-only endpoints
 * ================================================================ */
function verifyPin(pin) {
  try { checkPin_(pin); return true; } catch (e) { return false; }
}

function getAppData(pin) {
  checkPin_(pin);
  ensureStructureIfNeeded_();
  return appData_();
}

function appData_() {
  const out = {
    schema: { lead: schemaOut_('lead'), investor: schemaOut_('investor') },
    offsets: REMINDER_OFFSETS.map(o => ({ key: o.key, label: o.label, minutes: o.minutes })),
    activityTypes: OPT.activityType,
    team: teamList_().map(t => t.name),
    staleDays: staleDays_(),
    tasks: readTable_(SHEETS.TASKS, TASK_FIELDS).map(r => toClient_(TASK_FIELDS, r)),
    activities: readTable_(SHEETS.ACTIVITIES, ACTIVITY_FIELDS).map(r => toClient_(ACTIVITY_FIELDS, r))
  };
  Object.keys(ENTITIES).forEach(kind => {
    const ent = ENTITIES[kind];
    out[kind] = readTable_(ent.sheet, ent.fields).map(r => toClient_(ent.fields, r));
  });
  return out;
}

function schemaOut_(kind) {
  const e = ENTITIES[kind];
  return {
    label: e.label, stages: e.stages, closed: e.closed,
    fields: e.fields.filter(fd => fd.type.indexOf('hidden') !== 0).map(fd => ({
      k: fd.k, label: fd.label, type: fd.type, sec: fd.sec, opts: fd.opts || null, req: !!fd.req,
      full: !!fd.full, ph: fd.ph || '', list: fd.list || null, showIf: fd.showIf || null, help: fd.help || ''
    }))
  };
}

function getDashboard(pin) {
  ensureStructureIfNeeded_();
  const unlocked = pin ? verifyPin(pin) : false;
  const now = Date.now(), DAY = 864e5;
  const today = ymd_(new Date());
  const leads = readTable_(SHEETS.LEADS, LEAD_FIELDS);
  const invs = readTable_(SHEETS.INVESTORS, INVESTOR_FIELDS);
  const tasks = readTable_(SHEETS.TASKS, TASK_FIELDS);
  const staleAfter = staleDays_();

  const isOpen = (kind, r) => ENTITIES[kind].closed.indexOf(String(r.stage)) === -1;
  const sum = (arr, k) => arr.reduce((s, r) => s + (Number(r[k]) || 0), 0);
  const stageCounts = (list, stages) => stages.map(s => [s, list.filter(r => String(r.stage) === s).length]);
  const openLeads = leads.filter(r => isOpen('lead', r));
  const openInvs = invs.filter(r => isOpen('investor', r));
  const won = leads.filter(r => r.stage === 'Won');
  const committed = invs.filter(r => r.stage === 'Committed');
  const ddIdx = INVESTOR_STAGES.indexOf('Due Diligence');

  const openTasks = tasks.filter(t => t.status !== 'Done');
  const overdue = openTasks.filter(t => { const d = asDate_(t.due); return d && d.getTime() < now; });
  const dueToday = openTasks.filter(t => { const d = asDate_(t.due); return d && d.getTime() >= now && ymd_(d) === today; });

  const meetings = [];
  [['lead', leads], ['investor', invs]].forEach(([kind, list]) => list.forEach(r => {
    const m = asDate_(r.nextMeeting);
    if (m && m.getTime() >= now - 3600e3 && m.getTime() - now <= 7 * DAY) {
      meetings.push({ kind: kind, id: String(r.id), name: String(r.name), org: String(r.organization || ''),
                      priority: String(r.priority || ''), stage: String(r.stage || ''), when: m.toISOString(),
                      link: String(r.meetingLink || '') });
    }
  }));
  meetings.sort((a, b) => a.when.localeCompare(b.when));

  const rank = { High: 0, Medium: 1, Low: 2 };
  const stale = [];
  [['lead', openLeads], ['investor', openInvs]].forEach(([kind, list]) => list.forEach(r => {
    const next = asDate_(r.nextMeeting);
    if (next && next.getTime() > now) return;
    const last = asDate_(r.lastMeeting) || asDate_(r.createdAt);
    const days = last ? Math.floor((now - last.getTime()) / DAY) : 999;
    if (days >= staleAfter) {
      stale.push({ kind: kind, id: String(r.id), name: String(r.name), org: String(r.organization || ''),
                   priority: String(r.priority || ''), days: days, never: !asDate_(r.lastMeeting) });
    }
  }));
  stale.sort((a, b) => ((rank[a.priority] ?? 3) - (rank[b.priority] ?? 3)) || (b.days - a.days));

  const trend = [];
  for (let i = 7; i >= 0; i--) {
    const end = now - i * 7 * DAY, start = end - 7 * DAY;
    const inWeek = r => { const c = asDate_(r.createdAt); return c && c.getTime() > start && c.getTime() <= end; };
    trend.push({ label: Utilities.formatDate(new Date(start + DAY), CONFIG.TIMEZONE, 'd MMM'),
                 leads: leads.filter(inWeek).length, investors: invs.filter(inWeek).length });
  }

  const target = Number(String(getSetting_('Fundraise target (₹)')).replace(/[^\d.]/g, '')) || 0;

  return {
    unlocked: unlocked,
    appUrl: appUrl_(),
    title: CONFIG.APP_TITLE,
    staleDays: staleAfter,
    sales: {
      total: leads.length, open: openLeads.length,
      newWeek: leads.filter(r => { const c = asDate_(r.createdAt); return c && now - c.getTime() <= 7 * DAY; }).length,
      won: won.length, lost: leads.filter(r => r.stage === 'Lost').length,
      meetings7: meetings.filter(m => m.kind === 'lead').length,
      pipelineValue: unlocked ? sum(openLeads, 'dealValue') : null,
      wonValue: unlocked ? sum(won, 'dealValue') : null,
      stages: stageCounts(leads, SALES_STAGES),
      type: countBy_(leads, 'type', OPT.type),
      product: countBy_(leads, 'product', OPT.product),
      source: countBy_(leads, 'source', []),
      segment: countBy_(leads, 'segment', OPT.segment)
    },
    investors: {
      total: invs.length, active: openInvs.length,
      meetings7: meetings.filter(m => m.kind === 'investor').length,
      inDD: openInvs.filter(r => INVESTOR_STAGES.indexOf(String(r.stage)) >= ddIdx).length,
      committed: committed.length,
      committedAmount: unlocked ? sum(committed, 'amountCommitted') : null,
      target: unlocked ? target : null,
      stages: stageCounts(invs, INVESTOR_STAGES),
      type: countBy_(invs, 'investorType', OPT.investorType),
      tier: countBy_(invs, 'tier', OPT.tier)
    },
    tasks: { overdue: overdue.length, today: dueToday.length },
    trend: trend,
    agenda: unlocked ? meetings.slice(0, 15) : null,
    dueTasks: unlocked ? overdue.concat(dueToday).map(t => toClient_(TASK_FIELDS, t)).slice(0, 15) : null,
    stale: unlocked ? stale.slice(0, 12) : null
  };
}

/* ================================================================
 * Write endpoints — every one returns fresh app data
 * ================================================================ */
function saveRecord(pin, kind, input) {
  checkPin_(pin);
  const ent = entity_(kind);
  if (!input || !String(input.name || '').trim()) throw new Error('Name is required.');
  return withLock_(() => {
    const existing = input.id ? findRecord_(kind, input.id) : null;
    if (input.id && !existing) throw new Error('This record no longer exists. Refresh the page.');
    const now = new Date();
    const rec = fromClient_(ent.fields, input);
    rec.id = existing ? existing.id : newId_();
    if (ent.stages.indexOf(rec.stage) === -1) rec.stage = existing && existing.stage ? existing.stage : ent.stages[0];
    if (!rec.priority) rec.priority = 'Medium';
    const oldStage = existing ? String(existing.stage || '') : '';
    if (!existing || oldStage !== rec.stage) rec.stageChangedAt = now;

    const oldNext = existing ? asDate_(existing.nextMeeting) : null;
    const newNext = asDate_(rec.nextMeeting);
    if (!(oldNext && newNext && oldNext.getTime() === newNext.getTime())) rec.remindersSent = '';
    rec.createdAt = existing ? (asDate_(existing.createdAt) || now) : now;
    rec.updatedAt = now;

    writeRow_(ent.sheet, ent.fields, rec, existing ? existing._row : null);
    if (!existing) addActivity_(kind, rec.id, rec.name, now, 'Created', 'Added as ' + ent.label.toLowerCase() + ' · ' + rec.stage, '');
    else if (oldStage !== rec.stage) addActivity_(kind, rec.id, rec.name, now, 'Stage change', (oldStage || '—') + ' → ' + rec.stage, '');
    if (existing && String(existing.name) !== String(rec.name)) renameRelated_(rec.id, rec.name);

    return Object.assign(appData_(), { savedId: String(rec.id) });
  });
}

function setStage(pin, kind, id, stage) {
  checkPin_(pin);
  const ent = entity_(kind);
  if (ent.stages.indexOf(stage) === -1) throw new Error('Unknown stage.');
  return withLock_(() => {
    const r = findRecord_(kind, id);
    if (!r) throw new Error('Record not found.');
    if (String(r.stage) !== stage) {
      const now = new Date();
      writeRow_(ent.sheet, ent.fields, { stage: stage, stageChangedAt: now, updatedAt: now }, r._row);
      addActivity_(kind, r.id, r.name, now, 'Stage change', (r.stage || '—') + ' → ' + stage, '');
    }
    return appData_();
  });
}

function deleteRecord(pin, kind, id) {
  checkPin_(pin);
  const ent = entity_(kind);
  return withLock_(() => {
    const r = findRecord_(kind, id);
    if (!r) throw new Error('Record not found.');
    sheet_(ent.sheet).deleteRow(r._row);
    deleteWhere_(SHEETS.TASKS, TASK_FIELDS, t => String(t.recordId) === String(id));
    deleteWhere_(SHEETS.ACTIVITIES, ACTIVITY_FIELDS, a => String(a.recordId) === String(id));
    return appData_();
  });
}

function moveLeadToInvestors(pin, id) {
  checkPin_(pin);
  return withLock_(() => {
    const lead = findRecord_('lead', id);
    if (!lead) throw new Error('Lead not found.');
    const now = new Date();
    const rec = {};
    INVESTOR_FIELDS.forEach(fd => { if (lead[fd.k] !== undefined && lead[fd.k] !== '') rec[fd.k] = lead[fd.k]; });
    rec.stage = 'Outreach';
    rec.stageChangedAt = now;
    rec.updatedAt = now;
    writeRow_(SHEETS.INVESTORS, INVESTOR_FIELDS, rec, null);
    sheet_(SHEETS.LEADS).deleteRow(lead._row);
    updateWhere_(SHEETS.TASKS, TASK_FIELDS, t => String(t.recordId) === String(id), { kind: 'investor' });
    updateWhere_(SHEETS.ACTIVITIES, ACTIVITY_FIELDS, a => String(a.recordId) === String(id), { kind: 'investor' });
    addActivity_('investor', rec.id, rec.name, now, 'Note', 'Moved from Leads to Investors', '');
    return Object.assign(appData_(), { savedId: String(rec.id) });
  });
}

function logActivity(pin, a) {
  checkPin_(pin);
  const ent = entity_(a && a.kind);
  if (!String(a.summary || '').trim()) throw new Error('Write a short summary of what happened.');
  return withLock_(() => {
    const r = findRecord_(a.kind, a.recordId);
    if (!r) throw new Error('Record not found.');
    const now = new Date();
    const when = asDate_(a.date) || now;
    const type = OPT.activityType.indexOf(a.type) !== -1 ? a.type : 'Note';
    addActivity_(a.kind, r.id, r.name, when, type, a.summary, a.by);

    const upd = { updatedAt: now };
    if (type !== 'Note' && when.getTime() <= now.getTime() + 864e5) {
      const last = asDate_(r.lastMeeting);
      if (!last || when > last) upd.lastMeeting = when;
      // First real touch moves a brand-new record forward automatically
      if (String(r.stage) === ent.stages[0]) {
        upd.stage = ent.stages[1];
        upd.stageChangedAt = now;
        addActivity_(a.kind, r.id, r.name, now, 'Stage change', ent.stages[0] + ' → ' + ent.stages[1], '');
      }
    }
    if (String(a.nextStep || '').trim()) upd.nextStep = cleanText_(a.nextStep);
    writeRow_(ent.sheet, ent.fields, upd, r._row);

    if (a.followUp && String(a.followUp.title || '').trim()) {
      addTask_({ title: a.followUp.title, due: a.followUp.due, owner: a.followUp.owner,
                 kind: a.kind, recordId: r.id, recordName: r.name });
    }
    return appData_();
  });
}

function deleteActivity(pin, id) {
  checkPin_(pin);
  return withLock_(() => {
    deleteWhere_(SHEETS.ACTIVITIES, ACTIVITY_FIELDS, a => String(a.id) === String(id));
    return appData_();
  });
}

function saveTask(pin, t) {
  checkPin_(pin);
  if (!t || !String(t.title || '').trim()) throw new Error('Task title is required.');
  return withLock_(() => {
    let recordName = '';
    if (t.kind && t.recordId) {
      const r = findRecord_(t.kind, t.recordId);
      if (!r) throw new Error('Related record not found.');
      recordName = String(r.name);
    }
    if (t.id) {
      const ex = readTable_(SHEETS.TASKS, TASK_FIELDS).find(x => String(x.id) === String(t.id));
      if (!ex) throw new Error('Task not found.');
      const upd = { title: cleanText_(t.title), due: asDate_(t.due) || '', owner: cleanText_(t.owner || ''),
                    notes: cleanText_(t.notes || ''), kind: t.kind || '', recordId: t.recordId || '', recordName: recordName };
      const exDue = asDate_(ex.due);
      if (!(exDue && upd.due && exDue.getTime() === upd.due.getTime())) upd.remindedAt = '';
      writeRow_(SHEETS.TASKS, TASK_FIELDS, upd, ex._row);
    } else {
      addTask_(Object.assign({}, t, { recordName: recordName }));
    }
    return appData_();
  });
}

function setTaskDone(pin, id, done) {
