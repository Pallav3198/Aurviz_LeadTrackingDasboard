    f_('title', 'Designation', 'text', SEC.CONTACT),
    f_('organization', orgLabel, 'text', SEC.CONTACT, { h: 'Organization' }),
    f_('email', 'Email', 'email', SEC.CONTACT),
    f_('altEmail', 'Alternate Email', 'email', SEC.CONTACT),
    f_('phone', 'Phone', 'tel', SEC.CONTACT, { ph: '+91 …' }),
    f_('whatsapp', 'WhatsApp (if different)', 'tel', SEC.CONTACT, { h: 'WhatsApp' }),
    f_('linkedin', 'LinkedIn', 'url', SEC.CONTACT, { ph: 'linkedin.com/in/…' }),
    f_('website', 'Website', 'url', SEC.CONTACT),
    f_('city', 'City', 'text', SEC.CONTACT),
    f_('country', 'Country', 'text', SEC.CONTACT),
    f_('preferredContact', 'Preferred Contact', 'select', SEC.CONTACT, { opts: OPT.preferredContact, full: true })
